# CTU Registrar System - Environment Configuration
# Copy this file to .env and fill in your real credentials.
# Keep .env secure and NEVER share or commit actual passwords.

# Gmail SMTP Configuration for System Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=your_system_email@gmail.com
# Use a 16-character Google App Password (not your personal account password)
# Generate from: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME="CTU Registrar Office"
